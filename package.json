{
  "name": "@sangyuk-raccoon/dop-engine",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --project tsconfig.json",
    "build": "tsc --project tsconfig.build.json",
    "typecheck:consumer": "tsc --project consumer-tests/types/tsconfig.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test:built": "vitest run",
    "test:property": "vitest run tests/property",
    "test": "pnpm run build && pnpm run test:built",
    "pack:check:built": "node scripts/pack-check.mjs",
    "pack:check": "pnpm run build && pnpm run pack:check:built",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run typecheck:consumer && pnpm run typecheck:test && pnpm run test:built && pnpm run pack:check:built"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.23.0"
}
